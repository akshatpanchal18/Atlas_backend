{
    "compilerOptions": {
        "types": ["node", "multer"],
        "target": "ES2022",
        "module": "commonjs",
        // "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "moduleResolution": "node",
        "ignoreDeprecations": "6.0",
        "resolveJsonModule": true
    },
    "include": ["src/**/*","prisma.config.ts"],
    "exclude": ["node_modules", "dist"]
}